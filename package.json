{
  "name": "piggybudget",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "sh scripts/dev.sh",
    "dev:server": "sh -c 'cd apps/server && go run github.com/air-verse/air@v1.67.4 -c .air.toml'",
    "dev:web": "pnpm --filter @piggybudget/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm test:tooling && pnpm -r test",
    "test:tooling": "node --test scripts/*.test.js",
    "check": "pnpm config:check && pnpm lint && pnpm test && pnpm build",
    "config:check": "node scripts/config-check.js",
    "deploy": "node scripts/deploy.js",
    "release": "node scripts/release.js",
    "generate": "pnpm generate:api && pnpm generate:client",
    "generate:api": "go run ./apps/server/cmd/piggybudget openapi export",
    "generate:client": "pnpm --filter @piggybudget/web generate:client",
    "test:compatibility": "sh scripts/backup-restore-smoke-test.sh",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "concurrently": "^9.2.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.47.0"
  }
}
